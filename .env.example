ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5433/lms
DATABASE_URL_SYNC=postgresql+psycopg2://lms:lms@localhost:5433/lms

REDIS_URL=redis://localhost:6380/0

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# First super admin, created on startup while none exists. Password needs 8+ characters.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

CORS_ORIGINS=["http://localhost:3000"]

# "s3" stores uploads in the docker-compose storage service; "local" uses MEDIA_ROOT on disk.
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=lmsaccess
S3_SECRET_KEY=lmssecret123
S3_BUCKET=lms-media
S3_REGION=us-east-1

MEDIA_ROOT=media
MEDIA_MAX_UPLOAD_MB=1024
MEDIA_URL_EXPIRE_MINUTES=360
